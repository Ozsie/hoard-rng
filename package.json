{
	"name": "@hoard-engine/rng",
	"version": "0.1.0",
	"description": "HOARD engine: seedable RNG and dice rolls",
	"keywords": ["rng", "seedable", "dice", "deterministic", "game"],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js",
		"test": "vitest run",
		"check": "tsc --noEmit",
		"lint": "eslint -c .eslintrc.cjs --ext .ts src",
		"lint:fix": "eslint -c .eslintrc.cjs --fix --ext .ts src",
		"prettier": "prettier --check .",
		"prettier:format": "prettier --write .",
		"prepublishOnly": "npm run check && npm run build && npm test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Ozsie/hoard-rng.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"esbuild": "^0.28.2",
		"typescript": "^5.0.0",
		"vitest": "^5.1.0",
		"@typescript-eslint/eslint-plugin": "^5.45.0",
		"@typescript-eslint/parser": "^5.45.0",
		"eslint": "^8.49.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"eslint-plugin-svelte": "^2.30.0",
		"prettier": "^3.0.3"
	}
}
